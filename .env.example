# Banco do gateway (Postgres compartilhado, rede interna)
DATABASE_URL=postgres://sgp_gateway_app:SENHA@10.73.98.16:5432/sgp_gateway

# Escuta só no IP público da .241; o UFW libera a porta só para a .239
HOST=177.86.157.241
PORT=3200

# Defesa extra além do UFW: IPs aceitos pela aplicação (vírgula). Vazio = não filtra.
ALLOWED_IPS=177.86.157.239

LOG_LEVEL=info
SGP_TIMEOUT_MS=15000

# Um token por tenant. O nome da variável fica em gateway.tenants.sgp_token_env
SGP_TOKEN_VIVANET=

# Banco do SGP, SOMENTE LEITURA (status do funil do CRM). Opcional:
# sem esta variável, o Status CRM é deduzido (Em análise após o cadastro; Contrato realizado quando houver contrato).
SGP_DB_URL=postgres://consulta_sgp:SENHA@177.86.157.245:5432/dbsgp

# Tempo máximo da consulta ao SGP na identificação; passou disso, usa a base própria.
SGP_IDENTIFICAR_TIMEOUT_MS=6000
